{
  "manifest_version": 3,
  "name": "Quiz Solver AI",
  "key": "",
  "version": "1.1.0",
  "description": "Stealth learning assistant for post-attempt answer verification on interactive learning platforms.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "commands": {
    "activate-solver": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Activate Quiz Solver AI"
    },
    "region-select": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Region screenshot select"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
